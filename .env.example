HOST=127.0.0.1
PORT=3016
NODE_ENV=development
DEMO_MODE=false
# mock only works in development/test/staging, never production.
PAYMENT_MODE=off
# Set secrets through server environment. Never commit real values.
ADMIN_PASSWORD=
INTERNAL_SECRET=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
PUBLIC_ORIGIN=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
VITE_API_BASE=http://127.0.0.1:3016/api

# WeChat mini-program login only; server-side secret must never enter VITE_* or manifest.
WECHAT_APPID=
WECHAT_APPSECRET=
