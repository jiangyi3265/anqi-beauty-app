HOST=127.0.0.1
PORT=3016
NODE_ENV=development
DEMO_MODE=false
# off = store confirms payment; wechat = WeChat Pay (needs every WECHAT_PAY_* value below);
# mock only works in development/test/staging, never production.
PAYMENT_MODE=off
# Set secrets through server environment. Never commit real values.
ADMIN_PASSWORD=
INTERNAL_SECRET=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
PUBLIC_ORIGIN=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
VITE_API_BASE=http://127.0.0.1:3016/api

# WeChat mini-program login only; server-side secret must never enter VITE_* or manifest.
WECHAT_APPID=
WECHAT_APPSECRET=

# WeChat Pay API v3 (mini program JSAPI). Key files stay on the server, readable only by the service user.
# WECHAT_APPID above must be the mini program bound to this merchant. See docs/微信支付接入说明.md.
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_FILE=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_FILE=
WECHAT_PAY_NOTIFY_URL=https://anqiht.okam.top/api/pay/notify
